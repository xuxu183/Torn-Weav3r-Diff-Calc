    if (typeof GM_addStyle === 'function') {
      GM_addStyle(css);
    } else {
      const style = document.createElement('style');
      style.textContent = css;
      document.head.appendChild(style);
    }
  }

  function ensurePanel() {
    let panel = document.getElementById(ID);
    if (panel) return panel;

    panel = document.createElement('section');
    panel.id = ID;

    panel.innerHTML = `
      <header class="header">
        <strong>Market / Weav3r Difference Calculator</strong>
        <div class="actions">
          <button data-action="refresh">Refresh</button>
          <button data-action="asc">Difference ↑</button>
          <button data-action="desc" class="active">Difference ↓</button>
          <button data-action="default">Default</button>
          <button data-action="collapse">−</button>
          <button data-action="close">×</button>
        </div>
      </header>

      <div class="status">Waiting for listings...</div>

      <div class="content-area">
        <div class="content">
          <div class="table-stage"></div>
        </div>
        <div class="vertical-scroll">
          <div class="vertical-thumb"></div>
        </div>
      </div>

      <div class="horizontal-scroll"
           title="Scroll table horizontally"
           aria-label="Scroll table horizontally">
        <div class="horizontal-scroll-thumb"></div>
      </div>

      <footer>
        After-tax Market Price = Market Price × 95%;
        Difference = After-tax Market Price − Weav3r Price;
        Total Difference = Difference × Weav3r Listing Quantity;
        Difference Rate = Difference ÷ After-tax Market Price
      </footer>
    `;

    document.body.appendChild(panel);

    setupPanelEvents(panel);
    setupHorizontalScroll(panel);
    setupVerticalScroll(panel);
    setupDragging(panel);
    setupResizeObserver(panel);
    clampPanel(panel);

    return panel;
  }

  function setupPanelEvents(panel) {
    panel.addEventListener('click', event => {
      const button = event.target.closest('button[data-action]');
      if (!button) return;

      const action = button.dataset.action;

      if (action === 'refresh') {
        refresh();
        return;
      }

      if (['asc', 'desc', 'default'].includes(action)) {
        sortDirection = action;

        panel.querySelectorAll(
          '[data-action="asc"],[data-action="desc"],[data-action="default"]'
        ).forEach(btn => {
          btn.classList.toggle('active', btn.dataset.action === action);
        });

        renderRows();
        return;
      }

      if (action === 'collapse') {
        collapsed = !collapsed;

        const contentArea = panel.querySelector('.content-area');
        const horizontal = panel.querySelector('.horizontal-scroll');
        const footer = panel.querySelector('footer');

        if (collapsed) {
          savedHeight = panel.getBoundingClientRect().height;
          contentArea.hidden = true;
          horizontal.hidden = true;
          footer.hidden = true;
          button.textContent = '+';
          panel.style.height = 'auto';
          panel.style.minHeight = '0';
        } else {
          contentArea.hidden = false;
          horizontal.hidden = false;
          footer.hidden = false;
          button.textContent = '−';
          panel.style.height = `${savedHeight}px`;
          panel.style.minHeight = '160px';

          requestAnimationFrame(() => {
            panel._updateVerticalScroll?.();
            panel._updateHorizontalScroll?.();
          });
        }

        return;
      }

      if (action === 'close') {
        panel._resizeObserver?.disconnect();
        panel.remove();
      }
    });
  }

  function setupHorizontalScroll(panel) {
    const content = panel.querySelector('.content');
    const stage = panel.querySelector('.table-stage');
    const bar = panel.querySelector('.horizontal-scroll');
    const thumb = panel.querySelector('.horizontal-scroll-thumb');

    let scrollLeft = 0;
    let draggingThumb = false;
    let pointerStartX = 0;
    let scrollStart = 0;

    function getMetrics() {
      const viewportWidth = content.clientWidth;
      const table = stage.querySelector('table');

      const contentWidth = Math.max(
        content.scrollWidth,
        stage.scrollWidth,
        stage.offsetWidth,
        table ? table.scrollWidth : 0,
        viewportWidth
      );

      const trackWidth = bar.clientWidth;
      const maxScroll = Math.max(0, contentWidth - viewportWidth);

      let thumbWidth;

      if (maxScroll > 1 && contentWidth > 0) {
        thumbWidth = Math.min(
          trackWidth,
          Math.max(
            Math.min(24, trackWidth),
            trackWidth * viewportWidth / contentWidth
          )
        );
      } else {
        thumbWidth = trackWidth;
      }

      const maxThumbLeft = Math.max(0, trackWidth - thumbWidth);

      return {
        viewportWidth,
        contentWidth,
        trackWidth,
        maxScroll,
        thumbWidth,
        maxThumbLeft
      };
    }

    function updateWidth() {
      if (!panel.isConnected) return;

      const metrics = getMetrics();

      scrollLeft = Math.max(
        0,
        Math.min(scrollLeft, metrics.maxScroll)
      );

      // Keep the track visible; hide it only when the panel is collapsed.
      // When there is no horizontal overflow, the thumb fills the track.
      bar.hidden = collapsed || metrics.trackWidth <= 0;
      thumb.style.display = 'block';
      thumb.style.width =
        `${Math.min(metrics.trackWidth, metrics.thumbWidth)}px`;

      const thumbLeft = metrics.maxScroll > 1
        ? scrollLeft / metrics.maxScroll * metrics.maxThumbLeft
        : 0;

      thumb.style.left = `${thumbLeft}px`;

      if (Math.abs(content.scrollLeft - scrollLeft) > 1) {
        content.scrollLeft = scrollLeft;
      }
    }

    function setScrollFromPointer(clientX, centerThumb) {
      const rect = bar.getBoundingClientRect();
      const metrics = getMetrics();

      if (metrics.maxScroll <= 1 || metrics.maxThumbLeft <= 0) return;

      const localX = clientX - rect.left;

      const thumbLeft = Math.max(
        0,
        Math.min(
          centerThumb
            ? localX - metrics.thumbWidth / 2
            : localX,
          metrics.maxThumbLeft
        )
      );

      scrollLeft =
        thumbLeft / metrics.maxThumbLeft * metrics.maxScroll;

      content.scrollLeft = scrollLeft;
      updateWidth();
    }

    bar.addEventListener('pointerdown', event => {
      if (event.button !== 0 || bar.hidden) return;

      if (event.target === thumb) {
        draggingThumb = true;
        pointerStartX = event.clientX;
        scrollStart = content.scrollLeft;

        thumb.setPointerCapture(event.pointerId);
        event.preventDefault();
        event.stopPropagation();
      } else {
        setScrollFromPointer(event.clientX, true);
      }
    });

    thumb.addEventListener('pointermove', event => {
      if (!draggingThumb) return;

      const metrics = getMetrics();
      if (metrics.maxThumbLeft <= 0) return;

      const deltaX = event.clientX - pointerStartX;

      scrollLeft =
        scrollStart +
        deltaX / metrics.maxThumbLeft * metrics.maxScroll;

      scrollLeft = Math.max(
        0,
        Math.min(scrollLeft, metrics.maxScroll)
      );

      content.scrollLeft = scrollLeft;
      updateWidth();
      event.preventDefault();
    });

    function stopDragging() {
      draggingThumb = false;
    }

    thumb.addEventListener('pointerup', stopDragging);
    thumb.addEventListener('pointercancel', stopDragging);

    content.addEventListener('scroll', () => {
      scrollLeft = content.scrollLeft;
      updateWidth();
    }, { passive: true });

    panel._updateHorizontalScroll = updateWidth;

    requestAnimationFrame(updateWidth);
  }

  function setupVerticalScroll(panel) {
    const content = panel.querySelector('.content');
    const track = panel.querySelector('.vertical-scroll');
    const thumb = panel.querySelector('.vertical-thumb');

    let draggingThumb = false;
    let pointerStartY = 0;
    let scrollStart = 0;

    function updateThumb() {
      if (!panel.isConnected) return;

      const viewportHeight = content.clientHeight;
      const scrollHeight = content.scrollHeight;
      const trackHeight = track.clientHeight;

      if (scrollHeight <= viewportHeight + 1 || trackHeight <= 0) {
        thumb.style.display = 'none';
        return;
      }

      thumb.style.display = 'block';

      const thumbHeight = Math.max(
        24,
        trackHeight * viewportHeight / scrollHeight
      );

      const maxThumbTop = trackHeight - thumbHeight;
      const maxScroll = scrollHeight - viewportHeight;

      const thumbTop = maxScroll > 0
        ? content.scrollTop / maxScroll * maxThumbTop
        : 0;

      thumb.style.height = `${thumbHeight}px`;
      thumb.style.top = `${thumbTop}px`;
    }

    content.addEventListener('scroll', updateThumb);

    track.addEventListener('pointerdown', event => {
      if (event.target === thumb) return;
      if (thumb.style.display === 'none') return;

      const rect = track.getBoundingClientRect();
      const thumbHeight = thumb.offsetHeight;
      const clickY = event.clientY - rect.top;

      const thumbTop = Math.max(
        0,
        Math.min(
          clickY - thumbHeight / 2,
          track.clientHeight - thumbHeight
        )
      );

      const maxThumbTop = track.clientHeight - thumbHeight;
      const maxScroll = content.scrollHeight - content.clientHeight;

      content.scrollTop = maxThumbTop > 0
        ? thumbTop / maxThumbTop * maxScroll
        : 0;

      updateThumb();
    });

    thumb.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;

      draggingThumb = true;
      pointerStartY = event.clientY;
      scrollStart = content.scrollTop;

      thumb.setPointerCapture(event.pointerId);
      event.preventDefault();
      event.stopPropagation();
    });

    thumb.addEventListener('pointermove', event => {
      if (!draggingThumb) return;

      const trackHeight = track.clientHeight;
      const thumbHeight = thumb.offsetHeight;
      const maxThumbTop = trackHeight - thumbHeight;
      const maxScroll = content.scrollHeight - content.clientHeight;

      if (maxThumbTop <= 0) return;

      const deltaY = event.clientY - pointerStartY;
      const scrollDelta = deltaY / maxThumbTop * maxScroll;

      content.scrollTop = scrollStart + scrollDelta;
      updateThumb();
    });

    function stopDragging() {
      draggingThumb = false;
    }

    thumb.addEventListener('pointerup', stopDragging);
    thumb.addEventListener('pointercancel', stopDragging);

    panel._updateVerticalScroll = updateThumb;
  }

  function setupResizeObserver(panel) {
    if (typeof ResizeObserver !== 'function') return;

    const observer = new ResizeObserver(() => {
      panel._updateVerticalScroll?.();
      panel._updateHorizontalScroll?.();
    });

    observer.observe(panel);
    observer.observe(panel.querySelector('.content'));
    observer.observe(panel.querySelector('.table-stage'));

    panel._resizeObserver = observer;
  }

  function setupDragging(panel) {
    const header = panel.querySelector('.header');

    header.addEventListener('pointerdown', event => {
      if (event.target.closest('button')) return;
      if (event.button !== 0) return;

      const rect = panel.getBoundingClientRect();

      panel.style.left = `${rect.left}px`;
      panel.style.top = `${rect.top}px`;
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';

      dragging = true;
      dragOffsetX = event.clientX - rect.left;
      dragOffsetY = event.clientY - rect.top;

      header.setPointerCapture(event.pointerId);
      event.preventDefault();
    });

    header.addEventListener('pointermove', event => {
      if (!dragging) return;

      const maxLeft = Math.max(
        0,
        window.innerWidth - panel.offsetWidth
      );

      const maxTop = Math.max(
        0,
        window.innerHeight - panel.offsetHeight
      );

      const left = Math.min(
        maxLeft,
        Math.max(0, event.clientX - dragOffsetX)
      );

      const top = Math.min(
        maxTop,
        Math.max(0, event.clientY - dragOffsetY)
      );

      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
    });

    function stopDragging() {
      dragging = false;
    }

    header.addEventListener('pointerup', stopDragging);
    header.addEventListener('pointercancel', stopDragging);

    window.addEventListener('resize', () => {
      clampPanel(panel);
      panel._updateVerticalScroll?.();
      panel._updateHorizontalScroll?.();
    });
  }

  function clampPanel(panel) {
    if (!panel.isConnected) return;

    const rect = panel.getBoundingClientRect();
    const width = Math.min(rect.width, window.innerWidth);
    const height = Math.min(rect.height, window.innerHeight);

    panel.style.maxWidth = `${window.innerWidth}px`;
    panel.style.maxHeight = `${window.innerHeight}px`;

    const left = Math.max(
      0,
      Math.min(rect.left, window.innerWidth - width)
    );

    const top = Math.max(
      0,
      Math.min(rect.top, window.innerHeight - height)
    );

    panel.style.left = `${left}px`;
    panel.style.top = `${top}px`;
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
  }

  function buildRows(markets, listings) {
    const rows = [];
    const byId = new Map();

    for (const listing of listings) {
      if (!byId.has(listing.id)) {
        byId.set(listing.id, []);
      }

      byId.get(listing.id).push(listing);
    }

    for (const market of markets) {
      const matches = byId.get(market.id);
      if (!matches) continue;

      for (const listing of matches) {
        const adjusted = market.price * 0.95;
        const difference = adjusted - listing.price;

        const rate = adjusted > 0
          ? difference / adjusted * 100
          : 0;

        // Total Difference = Per-Item Difference × Weav3r Listing Quantity
        const totalDifference = difference * listing.qty;

        rows.push({
          itemId: market.id,
          itemName: market.name,
          marketSeller: market.seller,
          weav3rSeller: listing.seller,
          marketPrice: market.price,
          weav3rPrice: listing.price,
          marketQty: market.qty,
          weav3rQty: listing.qty,
          difference,
          totalDifference,
          rate
        });
      }
    }

    return rows;
  }

  function getSortedRows() {
    const rows = [...lastRows];

    if (sortDirection === 'asc') {
      rows.sort((a, b) => a.difference - b.difference);
    } else if (sortDirection === 'desc') {
      rows.sort((a, b) => b.difference - a.difference);
    }

    return rows;
  }

  function renderRows() {
    const panel = ensurePanel();
    const stage = panel.querySelector('.table-stage');
    const rows = getSortedRows();

    const directionText = sortDirection === 'asc'
      ? 'Difference: Low to High'
      : sortDirection === 'desc'
        ? 'Difference: High to Low'
        : 'Original Order';

    panel.querySelector('.status').textContent =
      `Matched ${rows.length} listing pairs; Sort: ${directionText}`;

    if (!rows.length) {
      stage.innerHTML =
        '<div class="empty">No matching item IDs found among the first five Item Market and Weav3r listings</div>';

      requestAnimationFrame(() => {
        panel._updateVerticalScroll?.();
        panel._updateHorizontalScroll?.();
      });

      return;
    }

    let html = `
      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th>Item Market Seller</th>
            <th>Weav3r Seller</th>
            <th>Item Market Price</th>
            <th>Weav3r Price</th>
            <th>Item Market / Weav3r Qty</th>
            <th>Per-Item Difference</th>
            <th>Total Difference</th>
            <th>Difference Rate</th>
          </tr>
        </thead>
        <tbody>
    `;

    for (const row of rows) {
      const differenceClass =
        row.difference >= 0 ? 'positive' : 'negative';

      const totalClass =
        row.totalDifference >= 0 ? 'positive' : 'negative';

      const rateClass =
        row.rate >= 0 ? 'positive' : 'negative';

      html += `
        <tr>
          <td>${esc(row.itemName)} (ID ${esc(row.itemId)})</td>
          <td>${esc(row.marketSeller)}</td>
          <td>${esc(row.weav3rSeller)}</td>
          <td>${money(row.marketPrice)}</td>
          <td>${money(row.weav3rPrice)}</td>
          <td>${row.marketQty} / ${row.weav3rQty}</td>
          <td class="${differenceClass}">${money(row.difference)}</td>
          <td class="${totalClass}">${money(row.totalDifference)}</td>
          <td class="${rateClass}">${row.rate.toFixed(2)}%</td>
        </tr>
      `;
    }

    html += '</tbody></table>';
    stage.innerHTML = html;

    requestAnimationFrame(() => {
      if (!panel.isConnected) return;

      panel._updateVerticalScroll?.();
      panel._updateHorizontalScroll?.();
    });
  }

  function refresh() {
    if (!document.body) return;

    const markets = getMarketListings().slice(0, MAX);
    const listings = getWeav3rListings().slice(0, MAX);

    lastRows = buildRows(markets, listings);
    renderRows();

    const panel = ensurePanel();

    const directionText = sortDirection === 'asc'
      ? 'Difference: Low to High'
      : sortDirection === 'desc'
        ? 'Difference: High to Low'
        : 'Original Order';

    panel.querySelector('.status').textContent =
      `Item Market ${markets.length}/${MAX}; Weav3r ${listings.length}/${MAX}; Matched ${lastRows.length} pairs; ${directionText}`;

    panel._updateVerticalScroll?.();
    panel._updateHorizontalScroll?.();
  }

  function init() {
    addStyles();
    ensurePanel();
    refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
