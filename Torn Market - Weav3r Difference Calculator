// ==UserScript==
// @name         Torn Market - Weav3r Difference Calculator
// @namespace    https://www.torn.com/page.php?sid=ItemMarket/
// @version      2.8
// @description  Calculates price differences and color-codes positive and negative values
// @match        https://www.torn.com/page.php?sid=ItemMarket*
// @grant        GM_addStyle
// @run-at       document-idle
// ==/UserScript==

(() => {
  'use strict';

  const ID = 'torn-weav3r-diff-panel';
  const MAX = 5;

  let sortDirection = 'desc';
  let lastRows = [];
  let collapsed = false;
  let dragging = false;
  let dragOffsetX = 0;
  let dragOffsetY = 0;
  let savedHeight = 440;

  const money = n => {
    const value = Math.round(n);
    return (value < 0 ? '-$' : '$') +
      Math.abs(value).toLocaleString('en-US');
  };

  function getText(root, selectors) {
    for (const selector of selectors) {
      const el = root.querySelector(selector);
      if (el?.textContent.trim()) return el.textContent.trim();
    }
    return '';
  }

  function parsePrice(value) {
    const match = String(value || '').replace(/,/g, '')
      .match(/-?\$\s*(\d+(?:\.\d+)?)/);
    return match ? Number(match[1].replace('$', '')) : 0;
  }

  function parseQty(value) {
    const match = String(value || '').replace(/,/g, '')
      .match(/(\d+(?:\.\d+)?)/);
    return match ? Number(match[1]) : 1;
  }

  function esc(value) {
    return String(value ?? '').replace(/[&<>"']/g, c => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[c]);
  }

  function getMarketListings() {
    const results = [];
    const seen = new Set();

    for (const row of document.querySelectorAll(
      'li[class*="rowWrapper"], li[class*="sellerRow"]'
    )) {
      if (results.length >= MAX || seen.has(row)) continue;
      seen.add(row);

      const img = row.querySelector('img[src*="/images/items/"]');
      if (!img) continue;

      const rect = row.getBoundingClientRect();
      if (!rect.width || !rect.height) continue;

      const src = img.getAttribute('src') || '';
      const itemId = src.match(/\/images\/items\/(\d+)\//)?.[1];
      const itemPrice = parsePrice(getText(row, ['[class*="price"]']));

      if (!itemId || !itemPrice) continue;

      results.push({
        id: String(itemId),
        name: img.alt?.trim() || `Item ${itemId}`,
        price: itemPrice,
        qty: parseQty(getText(row, [
          '[class*="available"]',
          '[class*="quantity"]'
        ])),
        seller: getText(row, [
          '[class*="userInfo"] a',
          '[class*="seller"] a',
          'a[href*="profiles.php"]',
          'a[href*="userId="]'
        ]) || 'Unknown Seller'
      });
    }

    return results;
  }

  function getWeav3rListings() {
    const results = [];
    const seen = new Set();

    for (const link of document.querySelectorAll('a[href*="tt-item-id="]')) {
      if (results.length >= MAX || seen.has(link.href)) continue;
      seen.add(link.href);

      let url;

      try {
        url = new URL(link.href, location.href);
      } catch {
        continue;
      }

      const itemId = url.searchParams.get('tt-item-id');
      const itemPrice = parsePrice(getText(link, ['[class*="price"]']));

      if (!itemId || !itemPrice) continue;

      results.push({
        id: String(itemId),
        price: itemPrice,
        qty: parseQty(getText(link, ['[class*="quantity"]'])),
        seller: getText(link, ['[class*="player-name"]']) || 'Unknown Seller'
      });
    }

    return results;
  }

